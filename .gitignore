# Monorepo .gitignore

# Environment & Secrets
.env
.env.*
!.env.example
!.env.docker.example
*.key

# Backend Laravel
backend-laravel/vendor/
backend-laravel/node_modules/
backend-laravel/public/storage
backend-laravel/public/build
backend-laravel/storage/*.key
backend-laravel/.phpunit.result.cache
backend-laravel/.env
backend-laravel/.env.*
!backend-laravel/.env.example
!backend-laravel/.env.docker.example

# Frontend Flutter
flutter/.dart_tool/
flutter/.flutter-plugins
flutter/.flutter-plugins-dependencies
flutter/.packages
flutter/build/
flutter/ios/.generated/
flutter/macos/.generated/
flutter/linux/flutter/ephemeral/
flutter/windows/flutter/ephemeral/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
